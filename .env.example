# xAI API key for Grok Imagine (https://console.x.ai)
XAI_API_KEY=

# Local API
PORT=8787
HOST=127.0.0.1

# Future Google image provider
GOOGLE_API_KEY=

# Optional: if you already run `grok agent serve` yourself
GROK_AGENT_URL=ws://127.0.0.1:2419
GROK_AGENT_SECRET=

# Path to grok binary if not on PATH (Windows example)
# GROK_BIN=C:\Users\marko\.grok\bin\grok.exe
